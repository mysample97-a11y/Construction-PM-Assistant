# Secrets — this app never needs a committed key, and nothing here should ever
# hold one. Kept anyway so an accidental local file cannot be pushed.
.env
.env.*
*.key
*.pem
secrets.json
credentials.json

# Workspace exports may contain real project and client data. Keep them out of
# the repo unless you deliberately commit a redacted sample.
*.cpma.json

# Dependencies (only needed for the test suite; the app itself has none)
node_modules/

# Build and editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log
npm-debug.log*
.cache/
