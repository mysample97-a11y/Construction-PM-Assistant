{
  "name": "bim-multi-site-tracker",
  "version": "1.0.0",
  "description": "Track BIM production across multiple sites from your own spreadsheet. Static, browser-only, bring-your-own-key.",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "python3 -m http.server 8000",
    "test": "node tools/verify-engine.mjs",
    "test:ui": "node --experimental-vm-modules tools/smoke-dom.mjs",
    "test:all": "node tools/verify-engine.mjs && node --experimental-vm-modules tools/smoke-dom.mjs"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1"
  },
  "license": "MIT"
}
